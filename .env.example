NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (approval alerts on a phone). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave both blank to run without push: the alert is then simply never sent and
# the "Get alerts on this device" menu entry hides itself.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services see; optional.
VAPID_SUBJECT=

# My Dashboard: figures published by the other systems (MBL, RMI, VISTA).
# Each app serves a small read-only JSON endpoint behind a bearer token; see
# docs/07-my-dashboard-external-summary.md for the contract and a route to
# copy. Only the apps whose URL is set get a card, so leaving these empty
# simply hides the "Other systems" section.
MBL_SUMMARY_URL=
MBL_SUMMARY_TOKEN=
RMI_SUMMARY_URL=
RMI_SUMMARY_TOKEN=
VISTA_SUMMARY_URL=
VISTA_SUMMARY_TOKEN=
